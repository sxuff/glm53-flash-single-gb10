+"""Owned prompt-role batching policy. Generic kernels and reduction plans unchanged."""
+import os
+def enabled():
+ value=os.environ.get('GLM_PROMPT_WIDE','0')
+ if value not in ('0','1'):raise ValueError('GLM_PROMPT_WIDE must be explicit0 or1')
+ return value=='1'
+def prompt_rows():return 256 if enabled() else 128
+def routed_window_rows(rows,*,prefill):
+ if type(prefill) is not bool or type(rows) is not int or rows<1:raise ValueError('Explicit role and positive capacity required')
+ return min(rows,256 if prefill and enabled() else 128)
