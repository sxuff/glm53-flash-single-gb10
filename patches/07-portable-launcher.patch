+"""Owned loader configuration/admission only. Original TensorFold operations unchanged.
+The host copy (mosaic-v59/runtime_loader_mosaic.py) first re-hashed the host's own source tree against a
+host-only receipt; that audit is left out here. run.sh checks the TensorFold commit and every patch SHA-256 instead."""
+def load_runtime(a,p,c,guard):
+ guard('before_Torch')
+ # Do not run site.main(): historical sitecustomize overlays must remain absent.
+ if sys.flags.no_site:sys.path.append('/opt/sglang/lib/python3.12/site-packages')
+ os.environ.update(TF_GLM_LATENT='1',TF_GLM_CACHE_GIB='0',TF_GLM_CACHE_ENTRIES='0',TF_GLM_PROFILE='0')
+ sys.path.insert(0,str(ORIGINAL))
+ import torch
+ from tokenizers import Tokenizer
+ from tensorfold.cuda import capacity,geometry
+ from tensorfold.families.glm5_next.cuda import forward,decode,weights
+ from tensorfold.engine.exact_sampling import Sampling
+ if torch.cuda.device_count()!=1:raise ValueError('exact one GPU TP1 required')
+ cfg0=weights.Config.read(a.model);cfg=configured(cfg0,c)
+ if (cfg.layers,cfg.heads,cfg.lin_heads,cfg.vocab,cfg.limit,cfg0.dense_limit)!=(45,64,64,154880,10.0,2051):raise ValueError('original full model geometry/clip contract')
+ h=capacity.headers(a.model);extra=weights.workspace_bytes(cfg,h,rows=2,prefill_rows=128,load_mtp=True)
+ # Use source geometry conservatively (it accounts 2048 prefill rows), no allocation.
+ geo0=geometry.mla_geometry({**capacity.config(a.model),'num_nextn_predict_layers':1},1,0,minimum_slots=2560,latent=True)
+ # minimum_slots within mla_geometry also controls its dense scratch estimate.
+ # Keep that source clamp2560, then set cache allocation floor independently.
+ geo=dataclasses.replace(geometry.with_fixed(geo0,extra+2*cfg.hidden*2),minimum_slots=c['cache_slots'])
+ forecast=capacity.estimate_weights(a.model,weights.packed_residency(cfg,load_mtp=True))
+ estimate=forecast.resident+max(forecast.staging,geo.bytes_at(c['cache_slots']))
+ if MEASURED85:
+  sample=guard('measured85_admission_live_guard');planned=MEASURED_PEAK
+  if planned+5*GIB>sample['host_available']:raise Unsupported('measured85_peak_plus4GiB_cannot_preserve_reserve')
+  admission=dict(policy='v42 measured peak reserved plus4GiB user-authorized',measured_v42_peak_reserved=MEASURED_PEAK,margin_bytes=4*GIB,planned_bytes=planned,host_available=sample['host_available'],required_host_available=planned+5*GIB,original_formula_diagnostic_bytes=estimate,formula_not_used_for85_admission=True,cache_slots=c['cache_slots'])
+ else:
+  guard('allocation_forecast_before_weights',estimate)
+  budget=min(95*GIB-3*GIB,guard('admission')['host_available']-23*GIB)
+  plan=capacity.make_plan(int(capacity.config(a.model)['max_position_embeddings']),c['cache_slots'],True,budget,forecast,geo)
+  try:window=capacity.choose(plan)
+  except ValueError as ex:raise Unsupported('original_config_admission_refused: '+str(ex)) from ex
+  admission=plan.receipt(window)
+ w=weights.load(a.model,rank=0,world=1,load_mtp=True);guard('after_full_load')
+ stops=tuple(p.get('stop_token_ids',w.cfg.eos))
+ if not set(w.cfg.eos)<=set(stops):raise ValueError('original stop IDs must survive')
+ w.cfg=dataclasses.replace(configured(w.cfg,c),eos=stops)
+ if len(w.layers)!=45 or w.world!=1 or w.comm is not None or w.head.n!=154880 or w.mtp is None or not w.meta.get('packed_exl3'):raise ValueError('full original TP1 loader contract')
+ e=decode.Engine(w,capacity=c['cache_slots'],max_rows=2,prefill_rows=128,graphs=False,long_context=c['long_context'])
+ hooks=SourceHooks(e,forward,decode,guard,torch)
+ tok=Tokenizer.from_file(str(a.model/'tokenizer.json'))
+ scratch=torch.empty((2,cfg.hidden),dtype=torch.bfloat16,device=w.device)
+ return e,tok,torch,decode,Sampling,scratch,forward,hooks,admission
