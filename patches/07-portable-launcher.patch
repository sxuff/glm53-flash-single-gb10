+"""The parts of the host's context-v42 runner that serving/server.py uses, copied unchanged.
+
+server.py imports this module as `m` and runs serving/loader_mosaic.py in its namespace. Every
+function and class below is byte-for-byte the host copy the 2026-10-05 mosaic receipts ran with;
+the host's qualification and logit-capture code, which serving never calls, is left out.
+"""
+from __future__ import annotations
+import dataclasses, hashlib, json, os, sys, time
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+ORIGINAL = HERE.parent / 'src'  # server.py sets this to the patched TensorFold source before loading
+GIB = 1024**3
+STAGE = 'tfglm-mosaic-v59-pipeline'  # server.py sets the same name; run.sh passes it as TFGLM_CONTROLLER_STAGE
+
+class SafetyAbort(BaseException):
+    """Hard abort, deliberately outside Exception handlers."""
+class Unsupported(RuntimeError): pass
+
+def configured(cfg,c):
+ # dense_limit is a read-only PROPERTY, not a dataclass field. Changing index_topk
+ # is the only config-only setter of its dense threshold; sparse stays original.
+ return dataclasses.replace(cfg,index_topk=c['dense_limit']-cfg.kpool+1,mtp_layers=1)
+
+def authorize(a):
+ if not a.authorized_guarded_gpu or a.stage!=STAGE or os.environ.get('TFGLM_CONTROLLER_STAGE')!=a.stage:raise ValueError('exact parent stage authorization required')
+ if a.host_swap_baseline_bytes<0:raise ValueError('numeric original host swap baseline required')
+ if os.environ.get('EXL3_INT8_GEMV')!='2':raise ValueError('original parent numeric mode EXL3_INT8_GEMV=2 required')
+ if 'torch' in sys.modules:raise ValueError('safety must run before Torch import')
+
+class SourceHooks:
+ """Read-only observation and hard guards, installed before graph capture."""
+ def __init__(self,e,f,api,guard,torch):
+  self.e=e;self.f=f;self.api=api;self.guard=guard;self.torch=torch;self.undo=[];self.counts={'index_update':0,'select_tokens':0,'sparse_attention':0};self.positions=[]
+  def install(obj,name,fn):
+   old=getattr(obj,name);self.undo.append((obj,name,old));setattr(obj,name,fn(old))
+  def stagewrap(old):
+   def call(w,st,b,tokens):
+    guard('prefix_or_target_stage');self.positions.append({'kind':'target','pos':st.pos,'rows':len(tokens)});return old(w,st,b,tokens)
+   return call
+  install(f,'stage',stagewrap);install(api,'stage',stagewrap)
+  from tensorfold.families.glm5_next.cuda import mtp,sparse,latent
+  def mtpwrap(old):
+   def call(w,st,b,tokens,hidden):
+    guard('MTP_stage');self.positions.append({'kind':'mtp','pos':st.mtp_len,'rows':len(tokens)});return old(w,st,b,tokens,hidden)
+   return call
+  install(mtp,'mtp_stage',mtpwrap);install(api,'mtp_stage',mtpwrap)
+  def counter(name):
+   def wrap(old):
+    def call(*a,**kw):self.counts[name]+=1;return old(*a,**kw)
+    return call
+   return wrap
+  install(sparse,'index_update',counter('index_update'));install(sparse,'select_tokens',counter('select_tokens'));install(latent,'sparse_attention',counter('sparse_attention'))
+ def close(self):
+  for obj,name,old in reversed(self.undo):setattr(obj,name,old)
+
+def collect(e,tok,c,torch,api,Sampling,scratch,guard):
+ """Original v33c depth-one kernels/sampler, owned safety/count clock loop."""
+ ids=c['raw_prompt_ids'];count=c['max_new_tokens'];stops=not c['force_length'];actual=[];emitted=[];stamps=[];keeps=[];depths=[];rounds=proposals=accepted=0
+ settings={k:c.get('sampler',{}).get(k,v) for k,v in {'temperature':0,'top_p':1,'top_k':0,'min_p':0}.items()}
+ sampling=Sampling(seed=c.get('seed') or 0,**settings);old=e.follow
+ def follow(xs):actual.extend(xs);old(xs)
+ def callback(xs):
+  torch.cuda.synchronize();emitted.extend(xs);stamps.append({'clock_ns':time.perf_counter_ns(),'count':len(xs)})
+ e.follow=follow;status='generated';error=None;before=dict(e.replays)
+ torch.cuda.synchronize();torch.cuda.reset_peak_memory_stats();start=time.perf_counter_ns()
+ try:
+  guard('request_start');first=api.prefill(e,ids,sampling,mtp=True,resume=None);callback([first]);pending=[first];hidden=scratch[:1];hidden.copy_(e.last_hidden)
+  while len(actual)<count and not(stops and actual[-1] in e.w.cfg.eos):
+   guard('each_decode')
+   limit=e.st.capacity if e.st.index is not None else e.w.cfg.dense_limit
+   room=limit-e.st.pos
+   if room<1:raise Unsupported('actual_position_exceeds_configured_envelope')
+   use=count-len(actual)>=2 and room>=2 and e.st.mtp_len+len(pending)<=limit
+   ds=api.draft(e,hidden,pending,e.st.pos+1,1,sampling) if use else []
+   ts=e.verify_window([actual[-1]]+ds);ds=ts[1:];R=len(ts);y=e.forward(ts);torch.cuda.synchronize()
+   sampled=e.sample(y[:R],[e.st.pos+1+r for r in range(R)],sampling)
+   keep=1+int(bool(ds) and sampled[0]==ds[0] and not(stops and sampled[0] in e.w.cfg.eos))
+   pos=e.st.pos;api.commit(e.w,e.st,e.buf,R,keep)
+   if e.st.pos!=pos+keep:raise ValueError('exact decode commit advance')
+   rounds+=1;proposals+=len(ds);accepted+=keep-1;keeps.append(keep);depths.append(len(ds))
+   e.follow(sampled[:keep]);callback(sampled[:keep]);pending=sampled[:keep];hidden=scratch[:keep];hidden.copy_(e.main_hidden(slice(0,keep)))
+  torch.cuda.synchronize();guard('request_finished')
+ except MemoryError as ex:raise SafetyAbort(str(ex)) from ex
+ except Unsupported as ex:status='unsupported';error=str(ex)
+ except (ValueError,RuntimeError,NotImplementedError) as ex:
+  if 'out of memory' in str(ex).lower():raise SafetyAbort(str(ex)) from ex
+  status='unsupported';error=type(ex).__name__+': '+str(ex)
+ finally:e.follow=old
+ end=time.perf_counter_ns()
+ if actual!=emitted or len(actual)>count or (status=='generated' and c['force_length'] and len(actual)!=count):raise ValueError('output/callback/count contract')
+ dt=(stamps[-1]['clock_ns']-stamps[0]['clock_ns'])/1e9 if len(stamps)>1 else None
+ ttft=(stamps[0]['clock_ns']-start)/1e9 if stamps else None
+ stop=actual[-1] if actual and stops and actual[-1] in e.w.cfg.eos else None
+ return dict(case_id=c.get('case_id',c.get('id')),collection_status=status,collection_errors=[error] if error else [],prompt_tokens=len(ids),requested_output_tokens=count,generated_tokens=len(actual),raw_output_ids=actual,raw_output=tok.decode(actual,skip_special_tokens=False),callback_ids=emitted,clock_events=stamps,finish_reason='unsupported' if status=='unsupported' else 'stop_token' if stop is not None else 'generation_limit',stop_token_id=stop,proposals=proposals,accepted=accepted,rounds=rounds,keeps=keeps,depths=depths,prefill_s=ttft,prefill_tok_s=len(ids)/ttft if ttft else None,decode_s=dt,decode_tok_s=(len(actual)-1)/dt if dt and status=='generated' else None,decode_tokens=max(0,len(actual)-1),wall_s=(end-start)/1e9,actual_state_position=e.st.pos,actual_MTP_position=e.st.mtp_len,peak_allocated=torch.cuda.max_memory_allocated(),peak_reserved=torch.cuda.max_memory_reserved(),graphreplay={k:e.replays[k]-before[k] for k in before},mtp_n=1,graphs=e.graphs is not None,CUDA_synchronized=True,clock_scope='CUDA-complete first-to-last emission; n-1 decode tokens; no file writes in interval')
