+class MTPDepthTests(unittest.TestCase):
+    """Several drafts a round (serving_defaults.json mtp_drafts above 1): same tokens as serial, wider commits."""
+    def setUp(self):
+        saved = serving.MTP_DRAFTS, serving.MTP_DEPTH
+        self.addCleanup(lambda: setattr(serving, 'MTP_DRAFTS', saved[0]) or setattr(serving, 'MTP_DEPTH', saved[1]))
+    def deep(self, sequence, landing, drafts=3, depth='fixed', **kwargs):
+        serving.MTP_DRAFTS, serving.MTP_DEPTH = drafts, depth
+        return Fake(sequence, landing, width=drafts + 1, **kwargs)
+    def serial(self, sequence, landing, count=128):
+        fake = Fake(sequence, landing)
+        fake.run(count, draft=False)
+        return fake
+    def test_one_draft_has_no_policy(self):
+        serving.MTP_DRAFTS = 1
+        self.assertIsNone(serving.depth_policy(NS(), Sampling()))
+    def test_three_drafts_commit_four_rows_and_match_serial(self):
+        sequence = [5, 6, 7, 8, 10, 14, 15, 16, 9]
+        fake = self.deep(sequence, Landing(closed=True))
+        fake.run(32)
+        self.assertEqual(fake.out, self.serial(sequence, Landing(closed=True)).out)
+        self.assertEqual(fake.commits, [(4, 4), (4, 4)])
+        self.assertEqual(fake.stats['draft_depths'], {3: 2})
+        self.assertEqual(fake.stats['accepted'], 6)
+        self.assertEqual(fake.landing.observed, fake.out)
+        self.assertEqual(fake.context, [20, 1] + fake.out[:-1])
+    def test_miss_keeps_the_matched_prefix_and_realigns_the_mtp_cache(self):
+        fake = self.deep(LONG, Landing(closed=True), wrong=(2, 9, 10, 23))
+        fake.run(128)  # Fake.mtp checks every MTP row's position after each rollback
+        self.assertEqual(fake.out, self.serial(LONG, Landing(closed=True)).out)
+        self.assertEqual(fake.commits[0], (4, 2))
+        self.assertEqual(fake.context, [20, 1] + fake.out[:-1])
+        self.assertEqual(fake.stats['accepted'], len(fake.out) - 1 - fake.stats['rounds'])
+    def test_unconstrained_path_matches_serial(self):
