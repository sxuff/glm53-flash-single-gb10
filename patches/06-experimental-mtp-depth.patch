+    def test_sampled_auto_policy_adapts_between_one_and_three(self):
+        fake = self.deep(LONG, Landing(closed=True), depth='auto')
+        fake.run(128, sampling=Sampling(temperature=0.3))
+        depths = fake.stats['draft_depths']
+        self.assertEqual(set(depths), {2, 3})  # starts at 2 (rate 0.8), climbs to 3 as every draft lands
+        rejected = self.deep(LONG, Landing(closed=True), depth='auto', reject=True)
