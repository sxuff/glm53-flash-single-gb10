+        self.assertEqual(rejected.out, fake.out)
+    def test_auto_policy_learns_from_every_drafted_round(self):
+        learned = []
+        class Spy(namespace['DepthPolicy']):
+            def next(self, drafted, accepted):
+                if drafted:
+                    learned.append((drafted, accepted))
+                return super().next(drafted, accepted)
+        fake = self.deep([5, 6, 7, 7, 7, 7, 7, 7, 8, 9], Landing(trigger_at=3), depth='auto')
+        fake.api.DepthPolicy = Spy
+        fake.run(32, sampling=Sampling(temperature=0.3))
+        self.assertGreater(fake.stats['serial_rounds'], 0)  # serial landing rounds sit between drafted ones
+        self.assertEqual(len(learned), sum(rounds for depth, rounds in fake.stats['draft_depths'].items() if depth))
+    def test_greedy_auto_policy_stops_chaining_on_low_confidence(self):
+        fake = self.deep(LONG, Landing(closed=True), depth='auto', draft_peak=1.0)
+        fake.run(128)
+        self.assertEqual(set(fake.stats['draft_depths']), {1})
+        sure = self.deep(LONG, Landing(closed=True), depth='auto')
+        sure.run(128)
+        self.assertEqual(set(sure.stats['draft_depths']), {3})
+        self.assertEqual(sure.out, fake.out)
